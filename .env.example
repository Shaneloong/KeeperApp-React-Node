# Frontend Configuration (React CRA uses PORT)
PORT=3000
REACT_APP_API_URL=http://localhost:5001
WDS_SOCKET_PORT=0

# Backend Configuration
BACKEND_PORT=5001
MONGODB_URI=mongodb://mongo:27017/KeeperAppDB

# Database Configuration
MONGO_PORT=27017

# If using MongoDB Atlas (cloud) instead, comment MONGODB_URI above and uncomment:
# DB_USERNAME=your_username
# DB_PASSWORD=your_password
